{
  "name": "@repo/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc",
    "check-types": "tsc --noEmit",
    "dev": "tsx watch --env-file=../../.env src/index.ts",
    "start": "node dist/index.js",
    "test:unit": "vitest run src/middleware/auth.test.ts",
    "test:integration": "node --env-file=../../.env ./node_modules/vitest/vitest.mjs run src/controllers/export.test.ts",
    "lint": "eslint . --max-warnings 0"
  },
  "dependencies": {
    "@repo/prisma": "workspace:*",
    "@repo/queue": "workspace:*",
    "@repo/redis": "workspace:*",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.81.2",
    "cookie-parser": "^1.4.7",
    "cors": "^2.8.5",
    "express": "^5.1.0",
    "helmet": "^8.1.0",
    "jsonwebtoken": "^9.0.3",
    "morgan": "^1.10.0",
    "zod": "^3.25.76"
  },
  "devDependencies": {
    "@repo/eslint-config": "workspace:*",
    "@repo/typescript-config": "workspace:*",
    "@types/bcryptjs": "^3.0.0",
    "@types/cookie-parser": "^1.4.10",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/morgan": "^1.9.10",
    "@types/node": "^22.15.3",
    "@types/supertest": "^7.2.1",
    "eslint": "^9.39.1",
    "supertest": "^7.2.2",
    "tsx": "^4.20.3",
    "typescript": "5.9.2",
    "vitest": "^4.1.10"
  }
}