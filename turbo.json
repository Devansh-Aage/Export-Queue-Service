{
  "$schema": "https://turborepo.dev/schema.json",
  "ui": "tui",
  "globalEnv": [
    "NODE_ENV",
    "DATABASE_URL",
    "REDIS_URL",
    "PORT",
    "HOST",
    "JWT_SECRET",
    "JWT_EXPIRES_IN",
    "WORKER_PORT",
    "WORKER_HOST",
    "WORKER_CONCURRENCY",
    "E2E_API_URL",
    "AWS_REGION",
    "S3_BUCKET",
    "S3_DATASET_PREFIX",
    "S3_OUTPUT_PREFIX"
  ],
  "tasks": {
    "build": {
      "dependsOn": [
        "^build"
      ],
      "inputs": [
        "$TURBO_DEFAULT$",
        ".env*"
      ],
      "outputs": [
        "dist/**"
      ]
    },
    "lint": {
      "dependsOn": [
        "^lint"
      ]
    },
    "check-types": {
      "dependsOn": [
        "^build"
      ]
    },
    "dev": {
      "dependsOn": [
        "^build"
      ],
      "cache": false,
      "persistent": true
    },
    "db:generate": {
      "cache": false
    },
    "db:migrate": {
      "cache": false
    },
    "db:push": {
      "cache": false
    },
    "test:unit": {
      "dependsOn": [
        "^build"
      ]
    }
  }
}