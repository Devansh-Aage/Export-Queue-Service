{
  "name": "export-service",
  "private": true,
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "dev:api": "turbo run dev --filter=@repo/api",
    "dev:worker": "turbo run dev --filter=@repo/worker",
    "lint": "turbo run lint",
    "format": "prettier --write \"**/*.{ts,tsx,md}\"",
    "check-types": "turbo run check-types",
    "db:generate": "turbo run db:generate --filter=@repo/prisma",
    "db:migrate": "turbo run db:migrate --filter=@repo/prisma",
    "db:push": "turbo run db:push --filter=@repo/prisma",
    "db:studio": "pnpm --filter @repo/prisma studio",
    "test:unit": "turbo run test:unit"
  },
  "devDependencies": {
    "prettier": "^3.7.4",
    "turbo": "^2.10.7",
    "typescript": "5.9.2"
  },
  "packageManager": "pnpm@9.0.0",
  "engines": {
    "node": ">=24"
  }
}